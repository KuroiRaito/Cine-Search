# Copy to `.env` (gitignored) and fill in. See docs/DEPLOY.md for the full table.
#
# The app degrades gracefully: with none of these it still boots into guest mode,
# with TMDB_API_KEY alone every browse and detail screen renders real content.

# Titles. Server-only -- NOT VITE_-prefixed, so it never reaches the browser.
# Used by /api/tmdb in production and by the Vite dev proxy locally.
# Your v3 key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Accounts. Without these, sign-in is disabled and guest mode still works.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
