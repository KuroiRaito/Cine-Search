{
  "name": "cine-search",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "eval": "vite-node eval/run.mjs --",
    "eval:build-set": "node eval/build-set.mjs",
    "eval:resolve": "node --env-file=.env eval/resolve.mjs",
    "eval:label": "node --env-file=.env eval/label-server.mjs",
    "eval:bench": "vite-node eval/bench.mjs --",
    "test:api": "node scripts/smoke-api.mjs",
    "verify": "node scripts/verify.mjs",
    "snap": "node scripts/snap.mjs",
    "auth": "node --env-file=.env scripts/auth-cases.mjs",
    "cohorts": "node scripts/title-cohorts.mjs",
    "find": "node --env-file-if-exists=.env scripts/find-cases.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "lucide-react": "^1.46.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.63.0",
    "vite": "^8.3.0",
    "vite-node": "^6.0.0"
  }
}
